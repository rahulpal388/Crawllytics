{
  "name": "Crawllytics",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,mjs,prettierrc}\"",
    "format:check": "prettier . --check",
    "check-types": "turbo run check-types",
    "services:start": " docker compose -f docker-compose.dev.yml up -d ",
    "services:stop": " docker compose -f docker-compose.dev.yml down "
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.9.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}